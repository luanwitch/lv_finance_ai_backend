# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False

# Database (leave empty to use SQLite locally; Render provides DATABASE_URL automatically)
DATABASE_URL=

# Hosts (Render: your-app.onrender.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (Render: https://your-frontend.onrender.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# AI
AI_PROVIDER=ollama
AUTHENTICATION_API_KEY=

# HTTPS (production)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
