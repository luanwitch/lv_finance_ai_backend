# Django
DJANGO_SECRET_KEY=our-django-secret-key
DJANGO_DEBUG=False

# Database (leave empty to use SQLite locally; Render provides DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Hosts — REQUIRED on Render (comma-separated, no trailing slash)
# Production:  lv-finance-ai-backend.onrender.com
# Localhost:   localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — REQUIRED on Render (comma-separated, no trailing slash)
# Production:  https://lv-finance-ia.vercel.app
# Preview:     https://lv-finance-<hash>-<user>.vercel.app  (auto-matched by regex)
# Regex in settings.py handles all Vercel preview URLs automatically.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# AI
AI_PROVIDER=ollama
AUTHENTICATION_API_KEY=

# HTTPS (production)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Logging (production)
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
