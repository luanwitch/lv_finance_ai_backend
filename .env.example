# ===========================================================================
# LV Finance Backend - Variaveis de ambiente (.env.example)
# Copie para .env e ajuste conforme o ambiente.
#
# REGRA DE OURO: separacao DEV / PRODUCAO.
#   - DEV LOCAL  -> DJANGO_DEBUG=True e DATABASE_URL vazio (SQLite dev.sqlite3).
#   - PRODUCAO   -> DJANGO_DEBUG=False e DATABASE_URL definida pelo Render/Neon
#                   (env var do painel do Render; nunca no .env).
#   - TESTES     -> SQLite em memoria, sempre; nunca usa banco remoto.
# NUNCA coloque credentials reais nem a URL do Neon no .env local.
# ===========================================================================

# ---------------------------------------------------------------------------
# Django - comum
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=our-django-secret-key
DJANGO_DEBUG=True

# Banco de dados.
# DEV LOCAL: deixe VAZIO -> usa SQLite local (dev.sqlite3), isolado de producao.
# PRODUCAO:  defina no painel do Render (NUNCA no .env) um Postgres/Neon,
#            ex.: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=

# Hosts permitidos (CSV, sem barra no final).
# DEV:  localhost,127.0.0.1
# PROD: Render injeta RENDER_EXTERNAL_HOSTNAME automaticamente
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (CSV, sem barra no final).
# DEV:  http://localhost:5173,http://127.0.0.1:5173
# PROD: https://lv-finance-ia.vercel.app (previews Vercel cobertas por regex)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
AI_PROVIDER=ollama
AUTHENTICATION_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# HTTPS / Seguranca - PRODUCAO apenas (settings.py ignora quando DEBUG=True)
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Email (confirmacao de e-mail / reset de senha)
# DEV:  EMAIL_BACKEND vazio -> console (imprime no log).
# PROD: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#       + credenciais SMTP (definidas no painel do Render).
# ---------------------------------------------------------------------------
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=LV Finance AI <no-reply@lvfinance.com>

# ---------------------------------------------------------------------------
# Frontend (link de confirmacao / reset)
# DEV:  http://localhost:5173 (Vite dev server)
# PROD: https://lv-finance-ia.vercel.app
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Validade dos tokens (horas)
# ---------------------------------------------------------------------------
EMAIL_VERIFICATION_TOKEN_LIFETIME_HOURS=24
# PASSWORD_RESET_TOKEN_LIFETIME_HOURS=1